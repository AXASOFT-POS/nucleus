{
    "$schema": "http://json-schema.org/draft/2020-12/schema",
    "title": "Topup response",
    "description": "Data odpovede eMoney transakcie",
    "type": "object",
     "properties": {
        "uuid": {"$ref": "https://raw.githubusercontent.com/AXASOFT-POS/nucleus/main/jsonSchema/baseSchema.json#/$defs/uuidv7"},
        "termBaseRespData": {"$ref": "https://raw.githubusercontent.com/AXASOFT-POS/nucleus/main/jsonSchema/baseSchema.json#/$defs/TerminalBaseRespData"},
                "serialNumber": {
                    "type": "string",
                    "$comment": "Seriove cislo eMoney produktu"
                },
                "code": {
                    "type": "string",
                    "$comment": "Kod produktu"
                }
                    "DatumExp": {
                    "type": "string",
                    "format": "date-time",
                    "$comment": "Datum expiracie produktu vo formáte RFC 3339, napr. 2025-08-22T09:18:01+02:00"
                }
   },
   "required": [
        "uuid",
        "termBaseRespData",
        "code"
    ]
}
